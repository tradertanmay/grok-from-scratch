# Any OpenAI-compatible endpoint
# Any laptop, no GPU (free Groq key): LLM_BASE_URL=https://api.groq.com/openai/v1
#                  LLM_MODEL=openai/gpt-oss-120b  LLM_API_KEY=gsk_...  GROK_EMBED_MODEL=
# 8-16 GB laptop (Ollama): LLM_BASE_URL=http://localhost:11434/v1   LLM_MODEL=qwen3:4b
# 32 GB+ (Ollama): LLM_BASE_URL=http://localhost:11434/v1   LLM_MODEL=gpt-oss:latest
# H100 (vLLM):    LLM_BASE_URL=http://<h100-host>:8000/v1  LLM_MODEL=openai/gpt-oss-120b
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=gpt-oss:latest
LLM_API_KEY=not-needed

# Optional
GROK_DB_PATH=grok_bot.sqlite3
GROK_MAX_TOOL_STEPS=8
# Use a SearXNG instance for web_search instead of DuckDuckGo HTML
SEARXNG_URL=
HOST=127.0.0.1
PORT=8000

# Multiple providers (local Ollama, free-tier APIs, H100 vLLM): copy providers.example.json to
# providers.json. Then model ids are "provider/model", e.g. LLM_MODEL=mac/gpt-oss:latest
GROK_PROVIDERS_FILE=providers.json
# Tried in order if the chosen model's provider is down (before any token was streamed)
GROK_FALLBACK_MODELS=
# Give up connecting to a provider after this many seconds, so an offline Mac fails over fast.
# A provider that fails to connect is skipped for 30 s.
GROK_CONNECT_TIMEOUT=5
# Spillover: once the first provider has this many streams in flight, new turns go to
# GROK_FALLBACK_MODELS first. Match OLLAMA_NUM_PARALLEL (4). 0 = off. Per provider:
# "max_concurrent" in providers.json.
GROK_MAX_CONCURRENT_PRIMARY=0
# API keys referenced as "$NAME" in providers.json
GROQ_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=

# python_exec isolation: auto (docker if available) | docker | subprocess
GROK_SANDBOX=auto
GROK_SANDBOX_IMAGE=python:3.11-slim
# Allow fetch_url to reach private/loopback addresses (off by default, SSRF guard)
GROK_ALLOW_PRIVATE_FETCH=

# Accounts: GROK_AUTH=off runs single-user (no login). First signup becomes admin.
GROK_AUTH=on
# Signup: open (anyone), invite (needs an admin invite code), closed. The first user can always sign up.
GROK_SIGNUP=open
# Max chat turns per non-admin user per UTC day (0 = unlimited).
GROK_DAILY_MESSAGES=0
# Public deploy on one Mac: GROK_DAILY_MESSAGES=100 and GROK_CHAT_RATE_LIMIT=10 (docs/DEPLOY.md)
GROK_ADMIN_USER=
GROK_ADMIN_PASSWORD=
# Set on when serving over HTTPS (Caddy).
GROK_COOKIE_SECURE=off
# Requests per minute: chat per user, login/signup per IP (0 = unlimited).
GROK_CHAT_RATE_LIMIT=30
GROK_AUTH_RATE_LIMIT=10

# Long-term memory (remember/forget tools + recall). Empty GROK_EMBED_MODEL = keyword search only.
GROK_MEMORY=on
GROK_EMBED_MODEL=nomic-embed-text

# Files / vision. Leave GROK_VISION_MODEL empty to send images to the chat model.
GROK_VISION_MODEL=
# Model used when Think is on and the user didn't pick one (e.g. mac/qwen3.6:35b).
GROK_THINK_MODEL=
GROK_MAX_UPLOAD_MB=20

# Ops: bearer token for GET /metrics (empty = disabled); one JSON log line per request.
GROK_METRICS_TOKEN=
GROK_LOG_JSON=off

# Backups (compose `backup` service / python -m grok_bot.backup)
GROK_BACKUP_HOURS=24
GROK_BACKUP_KEEP=7

# Background runner for scheduled Tasks (/api/tasks)
GROK_TASKS=on

# Voice: OpenAI-compatible /audio/transcriptions server (empty = /api/transcribe off).
# Mac mlx-whisper/whisper.cpp server, or Groq: https://api.groq.com/openai/v1 + whisper-large-v3-turbo
GROK_STT_URL=
GROK_STT_MODEL=whisper-1
GROK_STT_KEY=
